#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char key[] = "CIPHER";
    char cipher[27], message[200];
    int i, j, k = 0, used[26] = {0};

    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);
        if (!used[ch - 'A']) {
            cipher[k++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            cipher[k++] = 'A' + i;
        }
    }
    cipher[26] = '\0';

    printf("Cipher alphabet: %s\n", cipher);
    printf("Enter plaintext: ");
    fgets(message, sizeof(message), stdin);

    for (i = 0; message[i] != '\0'; i++) {
        if (isalpha((unsigned char)message[i])) {
            int index = toupper(message[i]) - 'A';
            char ch = cipher[index];
            message[i] = islower((unsigned char)message[i])
                       ? tolower(ch) : ch;
        }
    }

    printf("Encrypted message: %s", message);
    return 0;
}
