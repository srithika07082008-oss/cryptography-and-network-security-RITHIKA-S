#include <stdio.h>
#include <ctype.h>
#include <string.h>

char key[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void find(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (key[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main() {
    char cipher[500];
    char a, b;
    int i, r1, c1, r2, c2;

    printf("Enter ciphertext:\n");
    fgets(cipher, sizeof(cipher), stdin);

    printf("Decrypted message:\n");

    for (i = 0; cipher[i] != '\0'; ) {
        if (!isalpha((unsigned char)cipher[i])) {
            i++;
            continue;
        }

        a = toupper((unsigned char)cipher[i++]);

        while (cipher[i] &&
               !isalpha((unsigned char)cipher[i]))
            i++;

        if (cipher[i] == '\0')
            break;

        b = toupper((unsigned char)cipher[i++]);

        if (a == 'J') a = 'I';
        if (b == 'J') b = 'I';

        find(a, &r1, &c1);
        find(b, &r2, &c2);

        if (r1 == r2) {
            a = key[r1][(c1 + 4) % 5];
            b = key[r2][(c2 + 4) % 5];
        } else if (c1 == c2) {
            a = key[(r1 + 4) % 5][c1];
            b = key[(r2 + 4) % 5][c2];
        } else {
            a = key[r1][c2];
            b = key[r2][c1];
        }

        printf("%c%c ", a, b);
    }

    printf("\n");
    return 0;
}
