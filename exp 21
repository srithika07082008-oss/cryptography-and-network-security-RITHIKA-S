#include <stdio.h>

int P10[]={3,5,2,7,4,10,1,9,8,6};
int P8[]={6,3,7,4,8,5,10,9};
int IP[]={2,6,3,1,4,8,5,7};
int IPI[]={4,1,3,5,7,2,8,6};
int EP[]={4,1,2,3,2,3,4,1};
int P4[]={2,4,3,1};
int S0[4][4]={{1,0,3,2},{3,2,1,0},
              {0,2,1,3},{3,1,3,2}};
int S1[4][4]={{0,1,2,3},{2,0,1,3},
              {3,0,1,0},{2,1,0,3}};

int perm(int x, int *t, int n, int bits)
{
    int y=0,i;
    for(i=0;i<n;i++)
        y=(y<<1)|((x>>(bits-t[i]))&1);
    return y;
}

int ls(int x,int n)
{
    return ((x<<1)&((1<<n)-1))|(x>>(n-1));
}

void keys(int key,int *k1,int *k2)
{
    int x=perm(key,P10,10,10);
    int l=(x>>5)&31,r=x&31;
    l=ls(l,5); r=ls(r,5);
    *k1=perm((l<<5)|r,P8,8,10);
    l=ls(ls(l,5),5);
    r=ls(ls(r,5),5);
    *k2=perm((l<<5)|r,P8,8,10);
}

int fk(int x,int k)
{
    int l=x>>4,r=x&15;
    int e=perm(r,EP,8,4)^k;
    int a=(e>>4)&15,b=e&15;
    int row=((a&8)>>2)|(a&1),col=(a>>1)&3;
    int s=(S0[row][col]<<2);
    row=((b&8)>>2)|(b&1); col=(b>>1)&3;
    s|=S1[row][col];
    return ((l^perm(s,P4,4,4))<<4)|r;
}

int sd(int x,int key,int dec)
{
    int k1,k2,t;
    keys(key,&k1,&k2);
    x=perm(x,IP,8,8);
    if(dec){t=k1;k1=k2;k2=t;}
    x=fk(x,k1);
    x=((x&15)<<4)|(x>>4);
    x=fk(x,k2);
    return perm(x,IPI,8,8);
}

int main(void)
{
    int mode,key=0x1FD,iv=0xAA;
    int p[32],c[32],d[32],n,i,prev,ctr;
    int x;

    printf("1.ECB  2.CBC  3.CFB  4.CTR\n");
    printf("Enter mode: ");
    scanf("%d",&mode);
    printf("Enter number of bytes: ");
    scanf("%d",&n);
    if(n<1||n>32||mode<1||mode>4){
        printf("Invalid input\n");
        return 1;
    }
    printf("Enter plaintext bytes in hexadecimal:\n");
    for(i=0;i<n;i++) scanf("%x",&p[i]);

    prev=iv; ctr=0;
    for(i=0;i<n;i++){
        if(mode==1) c[i]=sd(p[i],key,0);
        else if(mode==2){
            c[i]=sd(p[i]^prev,key,0);
            prev=c[i];
        }
        else if(mode==3){
            c[i]=p[i]^sd(prev,key,0);
            prev=c[i];
        }
        else c[i]=p[i]^sd(ctr++,key,0);
    }

    printf("Ciphertext: ");
    for(i=0;i<n;i++) printf("%02X ",c[i]);

    prev=iv; ctr=0;
    for(i=0;i<n;i++){
        if(mode==1) d[i]=sd(c[i],key,1);
        else if(mode==2){
            d[i]=sd(c[i],key,1)^prev;
            prev=c[i];
        }
        else if(mode==3){
            d[i]=c[i]^sd(prev,key,0);
            prev=c[i];
        }
        else d[i]=c[i]^sd(ctr++,key,0);
    }

    printf("\nDecrypted: ");
    for(i=0;i<n;i++) printf("%02X ",d[i]);
    printf("\n");
    return 0;
}
