#include <stdio.h>
#include <string.h>
#include <ctype.h>

int modInverse(int a)
{
    int i;

    for (i = 1; i < 26; i++)
    {
        if ((a * i) % 26 == 1)
            return i;
    }

    return -1;
}

int main()
{
    char cipher[500];
    int a, b, inv, i;
    int p1 = 'E' - 'A';
    int c1 = 'B' - 'A';

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    /*
       Assume B represents E.
       Try every valid value of a.
    */

    for (a = 1; a < 26; a++)
    {
        inv = modInverse(a);

        if (inv == -1)
            continue;

        b = (c1 - a * p1) % 26;
        b = (b + 26) % 26;

        printf("\nPossible plaintext for a=%d, b=%d: ", a, b);

        for (i = 0; cipher[i] != '\0'; i++)
        {
            if (isalpha((unsigned char)cipher[i]))
            {
                int c = toupper((unsigned char)cipher[i]) - 'A';
                int p = (inv * (c - b + 26)) % 26;

                printf("%c", p + 'A');
            }
            else
            {
                printf("%c", cipher[i]);
            }
        }

        printf("\n");
    }

    return 0;
}
