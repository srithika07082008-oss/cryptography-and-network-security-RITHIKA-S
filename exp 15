#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

// Standard English letter frequencies (A-Z)
const double ENGLISH_FREQ[26] = {
    0.0817, 0.0149, 0.0278, 0.0425, 0.1270, 0.0223, 0.0202, 0.0609, 0.0697,
    0.0015, 0.0077, 0.0403, 0.0241, 0.0675, 0.0751, 0.0193, 0.0010, 0.0599,
    0.0633, 0.0906, 0.0276, 0.0098, 0.0236, 0.0015, 0.0197, 0.0007
};

// Structure to store decryption results for sorting
typedef struct {
    int key;
    double score;
    char *plaintext;
} DecryptionResult;

// Function to calculate how close the text matches English frequencies
double calculate_score(const char *text) {
    int counts[26] = {0};
    int total_letters = 0;
    double score = 0.0;

    for (int i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            counts[toupper(text[i]) - 'A']++;
            total_letters++;
        }
    }

    if (total_letters == 0) return 0.0;

    // Dot product scoring mechanism: higher score means a closer match to English
    for (int i = 0; i < 26; i++) {
        double observed_freq = (double)counts[i] / total_letters;
        score += observed_freq * ENGLISH_FREQ[i];
    }

    return score;
}

// Comparison function for qsort (descending order of scores)
int compare_results(const void *a, const void *b) {
    double score_a = ((DecryptionResult *)a)->score;
    double score_b = ((DecryptionResult *)b)->score;
    
    if (score_b > score_a) return 1;
    if (score_b < score_a) return -1;
    return 0;
}

int main() {
    char ciphertext[1000];
    int top_n;

    printf("Enter the ciphertext: ");
    if (fgets(ciphertext, sizeof(ciphertext), stdin) == NULL) {
        return 1;
    }
    // Remove newline character if present
    ciphertext[strcspn(ciphertext, "\n")] = '\0';

    printf("How many top possible plaintexts would you like to see? ");
    if (scanf("%d", &top_n) != 1 || top_n < 1 || top_n > 26) {
        printf("Invalid number. Setting default to 10.\n");
        top_n = 10;
    }

    DecryptionResult results[26];
    int len = strlen(ciphertext);

    // Try all 26 possible shift keys
    for (int key = 0; key < 26; key++) {
        results[key].key = key;
        results[key].plaintext = (char *)malloc((len + 1) * sizeof(char));

        for (int i = 0; i < len; i++) {
            if (isupper(ciphertext[i])) {
                results[key].plaintext[i] = ((ciphertext[i] - 'A' - key + 26) % 26) + 'A';
            } else if (islower(ciphertext[i])) {
                results[key].plaintext[i] = ((ciphertext[i] - 'a' - key + 26) % 26) + 'a';
            } else {
                results[key].plaintext[i] = ciphertext[i]; // Keep spaces and punctuation unchanged
            }
        }
        results[key].plaintext[len] = '\0';
        results[key].score = calculate_score(results[key].plaintext);
    }

    // Sort results based on score in descending order
    qsort(results, 26, sizeof(DecryptionResult), compare_results);

    // Print the top N results
    printf("\n--- Top %d Most Likely Plaintexts ---\n", top_n);
    for (int i = 0; i < top_n; i++) {
        printf("Rank %2d (Key: %2d, Likelihood Score: %.4f): %s\n", 
               i + 1, results[i].key, results[i].score, results[i].plaintext);
    }

    // Free allocated memory
    for (int key = 0; key < 26; key++) {
        free(results[key].plaintext);
    }

    return 0;
}
