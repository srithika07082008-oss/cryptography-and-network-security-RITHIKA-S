#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while (b != 0)
    {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main()
{
    char text[100];
    int a, b, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter a and b: ");
    scanf("%d %d", &a, &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if (gcd(a, 26) != 1)
    {
        printf("Invalid a value. Choose a relatively prime to 26.\n");
        return 1;
    }

    printf("Ciphertext: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)text[i]))
        {
            char base = isupper((unsigned char)text[i]) ? 'A' : 'a';
            int p = text[i] - base;
            printf("%c", (a * p + b) % 26 + base);
        }
        else
        {
            printf("%c", text[i]);
        }
    }

    return 0;
}
