#include <stdio.h>

int P10[]={3,5,2,7,4,10,1,9,8,6};
int P8[]={6,3,7,4,8,5,10,9};
int IP[]={2,6,3,1,4,8,5,7};
int IPI[]={4,1,3,5,7,2,8,6};
int EP[]={4,1,2,3,2,3,4,1};
int P4[]={2,4,3,1};

int S0[4][4]={
    {1,0,3,2},{3,2,1,0},
    {0,2,1,3},{3,1,3,2}
};
int S1[4][4]={
    {0,1,2,3},{2,0,1,3},
    {3,0,1,0},{2,1,0,3}
};

int perm(int x,int *t,int n,int bits)
{
    int y=0,i;
    for(i=0;i<n;i++)
        y=(y<<1)|((x>>(bits-t[i]))&1);
    return y;
}

int ls(int x,int n)
{
    return ((x<<1)&((1<<n)-1))|(x>>(n-1));
}

void generateKeys(int key,int *k1,int *k2)
{
    int x=perm(key,P10,10,10);
    int l=x>>5,r=x&31;

    l=ls(l,5);
    r=ls(r,5);
    *k1=perm((l<<5)|r,P8,8,10);

    l=ls(l,5);
    r=ls(r,5);
    l=ls(l,5);
    r=ls(r,5);
    *k2=perm((l<<5)|r,P8,8,10);
}

int fk(int x,int k)
{
    int l=x>>4,r=x&15;
    int e=perm(r,EP,8,4)^k;
    int a=e>>4,b=e&15;

    int row=((a&8)>>2)|(a&1);
    int col=(a>>1)&3;
    int s=S0[row][col]<<2;

    row=((b&8)>>2)|(b&1);
    col=(b>>1)&3;
    s|=S1[row][col];

    return ((l^perm(s,P4,4,4))<<4)|r;
}

int sdes(int x,int key)
{
    int k1,k2;
    generateKeys(key,&k1,&k2);

    x=perm(x,IP,8,8);
    x=fk(x,k1);
    x=((x&15)<<4)|(x>>4);
    x=fk(x,k2);

    return perm(x,IPI,8,8);
}

void printBinary(int x)
{
    int i;
    for(i=7;i>=0;i--)
        printf("%d",(x>>i)&1);
    printf(" ");
}

int main(void)
{
    int key=0x1FD;  /* 0111111101 */
    int p[3]={0x01,0x02,0x04};
    int c[3],d[3];
    int i,counter;

    /* CTR Encryption */
    counter=0;
    for(i=0;i<3;i++)
        c[i]=p[i]^sdes(counter++,key);

    printf("Ciphertext: ");
    for(i=0;i<3;i++)
        printBinary(c[i]);

    /* CTR Decryption */
    counter=0;
    for(i=0;i<3;i++)
        d[i]=c[i]^sdes(counter++,key);

    printf("\nDecrypted plaintext: ");
    for(i=0;i<3;i++)
        printBinary(d[i]);

    printf("\n");
    return 0;
}
