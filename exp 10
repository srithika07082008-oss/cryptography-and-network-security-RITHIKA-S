#include <stdio.h>
#include <string.h>
#include <ctype.h>

char key[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void find(char ch, int *r, int *c) {
    int i, j;
    if (ch == 'J') ch = 'I';

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (key[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
}

int main() {
    char text[200], s[400], a, b;
    int i, n = 0, r1, c1, r2, c2;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i]; i++) {
        if (isalpha((unsigned char)text[i])) {
            char ch = toupper((unsigned char)text[i]);
            if (ch == 'J') ch = 'I';
            s[n++] = ch;
        }
    }

    s[n] = '\0';

    for (i = 0; i < n; ) {
        a = s[i];

        if (i + 1 >= n) {
            b = 'X';
            i++;
        } else if (s[i] == s[i + 1]) {
            b = 'X';
            i++;
        } else {
            b = s[i + 1];
            i += 2;
        }

        find(a, &r1, &c1);
        find(b, &r2, &c2);

        if (r1 == r2) {
            a = key[r1][(c1 + 1) % 5];
            b = key[r2][(c2 + 1) % 5];
        } else if (c1 == c2) {
            a = key[(r1 + 1) % 5][c1];
            b = key[(r2 + 1) % 5][c2];
        } else {
            a = key[r1][c2];
            b = key[r2][c1];
        }

        printf("%c%c ", a, b);
    }

    return 0;
}
